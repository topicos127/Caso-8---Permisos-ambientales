# Copie este archivo como .env y cambie los valores.
# .env no se sube a GitHub (esta en .gitignore).

# Base de datos local (docker compose)
MYSQL_ROOT_PASSWORD=cambie-esta-contrasena
MYSQL_DATABASE=permisos_ambientales

# Firma la cookie de sesion. Use un texto largo y aleatorio; por ejemplo, en
# PowerShell:  -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_})
# Si falta, la app arranca igual pero las sesiones se pierden al reiniciar.
SECRET_KEY=cambie-esta-clave

# Solo en el despliegue con HTTPS: la cookie de sesion viaja solo por HTTPS.
SESSION_COOKIE_SECURE=false
