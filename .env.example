# Copie este archivo como .env y cambie los valores.
# .env no se sube a GitHub (esta en .gitignore).

# Base de datos local (docker compose)
MYSQL_ROOT_PASSWORD=cambie-esta-contrasena
MYSQL_DATABASE=permisos_ambientales

# Firma la cookie de sesion. Use un texto largo y aleatorio; por ejemplo, en
# PowerShell:  -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_})
# Si falta, la app arranca igual pero las sesiones se pierden al reiniciar.
SECRET_KEY=cambie-esta-clave

# Solo en el despliegue con HTTPS: la cookie de sesion viaja solo por HTTPS.
SESSION_COOKIE_SECURE=false

# Administrador de la plataforma (crea empresas, respaldos, estado). Cambie la contrasena.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=Cambie-Esta-Clave-2026

# La sesion se cierra tras estos minutos sin actividad.
SESION_MINUTOS=120

# Archivos subidos. local = volumen de Docker. s3 = cualquier servicio compatible con S3
# (Cloudflare R2, Backblaze B2, MinIO, AWS S3); asi los documentos sobreviven a un redespliegue.
ALMACENAMIENTO=local
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=permisos-ambientales
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Respaldo automatico diario (hora de Panama) y cuantos se conservan.
RESPALDO_AUTOMATICO=true
RESPALDO_HORA=2
RESPALDOS_CONSERVAR=14
